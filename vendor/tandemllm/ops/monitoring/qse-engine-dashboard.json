          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(qse_request_decode_tokens_per_second_bucket[15m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(qse_request_decode_tokens_per_second_bucket[15m])))",
