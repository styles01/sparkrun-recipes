# systemd USER unit for chatd (the Chat tab's service, OPS-103) alone, for the installer's layout
# (~/TandemLLM: the checkout in src, the venv in venv, secrets.env in state). Not installed by
# install.sh: there chatd starts with the engine (ops/start.sh) and `tandem stop`, the stop of
# tandemllm.service included, stops it (OPS-155). This unit is for a box that runs chatd under
# systemd on its own; then set QSE_CHATD=off in run/local.env so start.sh leaves it to the unit.
# A user unit dies with the login session unless linger is enabled (sudo loginctl enable-linger).
#
# Install with (another --dir: replace %h/TandemLLM below):
#   mkdir -p ~/.config/systemd/user && cp ~/TandemLLM/src/ops/chatd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now chatd
#
# Its own unit, never the engine's: restarting the engine leaves chatd and its runs alone (a run
# waits for the engine and retries for 10 minutes). SIGTERM ends open runs `interrupted`. The forward
# key comes from the engine's secrets.env; the admin and metrics tokens there never reach chatd.
[Unit]
Description=TandemLLM chatd, the Chat tab's service on 127.0.0.1:8016
After=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/TandemLLM/src
EnvironmentFile=-%h/TandemLLM/state/secrets.env
UnsetEnvironment=QSE_ADMIN_TOKEN QSE_METRICS_TOKEN
Environment=PYTHONPATH=%h/TandemLLM/src
ExecStart=%h/TandemLLM/venv/bin/python -u -m chatd --host 127.0.0.1 --port 8016 --data %h/.tandemllm/chat
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/TandemLLM/src/logs/chatd.log
StandardError=append:%h/TandemLLM/src/logs/chatd.log

[Install]
WantedBy=default.target
