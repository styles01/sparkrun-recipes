# tandem-sandbox:1, the chat's sandbox image (SRV-355, OPS-103). Built on the box that runs it
# (ops/sandbox/build.sh); nothing is built on a laptop. Debian bookworm, arm64 or amd64 alike:
# Python 3.12, Node 18 and npm, git, ripgrep, jq, curl, build tools, headless Chromium and fonts,
# and uv. The agent runs as `agent` (uid 1000). The root filesystem is mounted read-only; /workspace,
# /home/agent and /tmp are the writable places. Chromium runs with --no-sandbox and --disable-gpu
# for every caller (/etc/chromium.d/tandem): the container is the sandbox; live (2026-10-13) the
# agent's own `chromium --headless` failed with "No usable sandbox!".
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ripgrep jq curl ca-certificates build-essential nodejs npm \
        chromium fonts-dejavu-core fonts-liberation procps less vim-tiny unzip zip \
        util-linux iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv pydantic \
    && useradd -m -u 1000 -s /bin/bash agent \
    && mkdir -p /workspace /opt/tandem /run/tandem && chown agent:agent /workspace \
    && printf 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --disable-gpu --disable-dev-shm-usage"\n' \
        > /etc/chromium.d/tandem
COPY relay.py /opt/tandem/relay.py
RUN git config --system init.defaultBranch main \
    && git config --system --add safe.directory /workspace \
    && echo 'export PS1="\[\e[32m\]sandbox\[\e[0m\]:\[\e[34m\]\w\[\e[0m\]$ "' >> /etc/bash.bashrc
USER agent
WORKDIR /workspace
LABEL org.opencontainers.image.title="tandem-sandbox" org.opencontainers.image.version="1"
CMD ["python3", "/opt/tandem/relay.py", "serve"]
