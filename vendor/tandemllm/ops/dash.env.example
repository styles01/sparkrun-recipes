# The dashboard and proxy from an env file: copy to dash.env, fill in, and start with
#
#   tandem-dash serve --env-file dash.env                     (pip install tandemllm)
#   docker run --env-file dash.env -p 127.0.0.1:8080:8080 -v tandem-dash:/data tandemllm-dash
#
# One KEY=VALUE a line, no quotes (docker passes quotes through as part of the value), no spaces
# around `=`. A variable set here wins over the GUI for that field: the Backends screen shows it
# locked with the variable's name. Keys from this file stay in memory and are never written to the
# config database. Keep this file mode 0600 and out of version control. Full list: docs/proxy.md.

# --- the server -----------------------------------------------------------------------------
# where it listens (the image sets 0.0.0.0 and 8080; publish the port to 127.0.0.1 or a LAN address)
#TANDEM_HOST=127.0.0.1
#TANDEM_PORT=8080
# the config database and the usage ledger (the image keeps both in /data)
#TANDEM_CONFIG_DB=~/.tandemllm/config.sqlite3
#TANDEM_USAGE_LEDGER=~/.tandemllm/ledger.sqlite3
# the admin password: unset (the default), every route is open and the dashboard asks for nothing,
# so keep the port on a trusted network; set (32 random characters or more), writes need it
#TANDEM_ADMIN_TOKEN=
#TANDEM_DASHBOARD_LOGIN=off
# the master key for keys at rest: base64 of 32 bytes (`openssl rand -base64 32`); without it the
# keychain, then a key file beside the config database
#TANDEM_SECRETS_KEY=

# --- backends -------------------------------------------------------------------------------
TANDEM_BACKENDS=deepseek,vllm1

# a cloud API: its kind fills the URL in
TANDEM_BACKEND_DEEPSEEK_KIND=deepseek
TANDEM_BACKEND_DEEPSEEK_KEY=sk-replace-me
#TANDEM_BACKEND_DEEPSEEK_LABEL=DeepSeek

# any OpenAI-compatible server (vLLM, SGLang, llama.cpp, LM Studio, Ollama, another TandemLLM)
TANDEM_BACKEND_VLLM1_KIND=generic
TANDEM_BACKEND_VLLM1_URL=http://gpu-box:8000/v1
#TANDEM_BACKEND_VLLM1_FALLBACK=deepseek
# requests at once: none (the default) is no limit from the proxy; a number caps it
#TANDEM_BACKEND_VLLM1_MAX_INFLIGHT=none
#TANDEM_BACKEND_VLLM1_TIMEOUT_FIRST_BYTE=600
# where the System view reads that machine: auto (this machine when the URL is), same, collector,
# exporter, off. A collector is `tandem-dash hostcollect --host 0.0.0.0` on gpu-box
#TANDEM_BACKEND_VLLM1_HOST=collector
#TANDEM_BACKEND_VLLM1_HOST_URL=http://gpu-box:9108
# or the node_exporter and DCGM exporter pages already running there (no per-process figures)
#TANDEM_BACKEND_VLLM1_HOST=exporter
#TANDEM_BACKEND_VLLM1_HOST_URL=http://gpu-box:9100/metrics
#TANDEM_BACKEND_VLLM1_HOST_DCGM_URL=http://gpu-box:9400/metrics
# the remote collectors' bearer token, the same value on both sides
#TANDEM_COLLECTOR_TOKEN=

# --- routing, prices, users -----------------------------------------------------------------
# ordered rules: a model id that matches the glob goes to the backend
#TANDEM_ROUTE_1=deepseek-*=deepseek
# USD per million tokens: input, cached input, output[, cache write]
#TANDEM_PRICE_1=deepseek/deepseek-flash=0.30,0.006,1.2
#TANDEM_PRICE_1_OFFPEAK=0.15,0.003,0.6
# the proxy's own keys for clients, label:key (from the first one on, a request needs a key)
#TANDEM_API_KEYS=laptop:tdm-replace-with-32-random-characters
