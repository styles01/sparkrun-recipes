  {"kind": "aws_secret", "text": "aws_secret_access_key = {secret}", "secret": "{B:40}"},
  {"kind": "github_token", "text": "remote: https://x-access-token@github.example.test (token {secret})", "secret": "gh{p}_{A:36}"},
  {"kind": "github_token", "text": "GH token in the CI log: {secret}", "secret": "github_pat_{A:22}_{A:59}"},
  {"kind": "gitlab_token", "text": "PRIVATE-TOKEN: {secret}", "secret": "glpat-{A:20}"},
  {"kind": "api_key", "text": "client = OpenAI(api_key={secret})", "secret": "sk-proj-{A:48}"},
