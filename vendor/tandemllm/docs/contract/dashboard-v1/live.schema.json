{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/dashboard-v1/live.schema.json",
  "title": "GET /v1/dashboard/live (follow=0), and the data of one `event: live` (follow=1); contract 1.1 adds seq, engine, activity, timeline, recent, sampler; VIS-40 adds the live rates without the warm-up (windows, now.*_live_*, sample.*_live_tps, per request decode_live_* / decode_warmup / mostly_cached, activity.prefill.tps_live*/warmup), all optional so an older 1.1 server still validates",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.1",
        "1.2"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "rises by one per event; also the SSE id"
    },
    "generated_at": {
      "type": "string"
    },
    "interval_s": {
      "type": "number",
      "minimum": 0
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "counts": {
      "type": "object",
      "properties": {
        "in_flight": {
          "type": "integer",
          "minimum": 0
        },
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "prefilling": {
          "type": "integer",
          "minimum": 0
        },
        "decoding": {
          "type": "integer",
          "minimum": 0
        },
        "completed_1m": {
          "type": "integer",
          "minimum": 0
        },
        "served": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "in_flight",
        "queued",
        "prefilling",
        "decoding",
        "completed_1m",
        "served",
        "errors",
        "refused"
      ],
      "additionalProperties": false
    },
    "now": {
      "type": "object",
      "properties": {
        "decode_tps": {
          "type": [
            "number",
            "null"
          ]
        },
        "prefill_tps": {
          "type": [
            "number",
            "null"
          ]
        },
        "prefilling": {
          "type": "boolean"
        },
        "tokens_per_block": {
          "type": [
            "number",
            "null"
          ]
        },
        "last_prefill_ms_ago": {
          "type": [
            "number",
            "null"
          ]
        },
        "prefill_live_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "the in-flight prefills' now-rates summed (activity.prefill.tps_live), after each one's warm-up chunk(s); null when no prefill has one. 1.1, VIS-40"
        },
        "prefill_live_count": {
          "type": "integer",
          "minimum": 0,
          "description": "how many prefills are in prefill_live_tps"
        },
        "decode_live_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "the decoding requests' decode_live_now_tps summed; null when none is past its warm-up. 1.1, VIS-40"
        },
        "decode_warming": {
          "type": "integer",
          "minimum": 0,
          "description": "decoding requests still before their warm-up anchor"
        }
      },
      "required": [
        "decode_tps",
        "prefill_tps",
        "prefilling",
        "tokens_per_block",
        "last_prefill_ms_ago"
      ],
      "additionalProperties": false
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "recent": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/recent"
      },
      "description": "the last 20 finished requests, newest first, kept 15 minutes; null with --live-activity off"
    },
    "sample": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "t": {
          "type": "number"
        },
        "decode_tps": {
          "type": [
            "number",
            "null"
          ]
        },
        "prefill_tps": {
          "type": [
            "number",
            "null"
          ]
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "waiting": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "decode_live_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "each decoding request's tokens over this second, counted from its warm-up anchor when that came later, summed; null when none was past its anchor. 1.1, VIS-40"
        },
        "prefill_live_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "the in-flight prefills' now-rate at this second (a mostly cached one left out), else null. 1.1, VIS-40"
        }
      },
      "required": [
        "t",
        "decode_tps",
        "prefill_tps",
        "running",
        "waiting",
        "tokens"
      ],
      "additionalProperties": false
    },
    "sampler": {
      "type": "object",
      "properties": {
        "ticks": {
          "type": "integer",
          "minimum": 0
        },
        "encodes": {
          "type": "integer",
          "minimum": 0
        },
        "tick_us_last": {
          "type": [
            "number",
            "null"
          ]
        },
        "tick_us_mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "tick_us_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "tick_cpu_us_mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "tick_cpu_us_max": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "ticks",
        "encodes",
        "tick_us_last",
        "tick_us_mean",
        "tick_us_max",
        "tick_cpu_us_mean",
        "tick_cpu_us_max"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "windows": {
      "type": "object",
      "description": "the live rates' settings (QSE_LIVE_*). 1.1, VIS-40",
      "properties": {
        "decode_warmup_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "a request's live decode window starts at its first tick with this many decoded tokens"
        },
        "prefill_warmup_chunks": {
          "type": "integer",
          "minimum": 0,
          "description": "the live prefill rate starts after this many chunks"
        },
        "now_window_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "the now-rates' window"
        },
        "mostly_cached_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mostly_cached_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "decode_warmup_tokens",
        "prefill_warmup_chunks",
        "now_window_s",
        "mostly_cached_pct",
        "mostly_cached_tokens"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "seq",
    "generated_at",
    "interval_s",
    "engine",
    "counts",
    "now",
    "requests",
    "sample",
    "recent"
  ],
  "additionalProperties": false,
  "$defs": {
    "sample": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number"
        },
        "decode_tps": {
          "type": [
            "number",
            "null"
          ]
        },
        "prefill_tps": {
          "type": [
            "number",
            "null"
          ]
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "waiting": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "decode_live_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "each decoding request's tokens over this second, counted from its warm-up anchor when that came later, summed; null when none was past its anchor. 1.1, VIS-40"
        },
        "prefill_live_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "the in-flight prefills' now-rate at this second (a mostly cached one left out), else null. 1.1, VIS-40"
        }
      },
      "required": [
        "t",
        "decode_tps",
        "prefill_tps",
        "running",
        "waiting",
        "tokens"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "queued",
            "prefill",
            "decode",
            "done"
          ]
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "stop",
            "length",
            "tool_calls",
            "timeout",
            "abandoned",
            "error",
            "refused",
            null
          ]
        },
        "status": {
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "client": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "open-webui",
                "openai-sdk",
                "opencode",
                "curl",
                "dashboard",
                "other",
                "internal"
              ]
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": false
        },
        "endpoint": {
          "type": "string",
          "enum": [
            "chat",
            "completions"
          ]
        },
        "stream": {
          "type": "boolean"
        },
        "thinking": {
          "type": "boolean"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "prompt_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cached_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "forwarded_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "blocks": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokens_per_block": {
          "type": [
            "number",
            "null"
          ]
        },
        "elapsed_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "queue_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "prompt_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "ttft_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "decode_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "prefill_tps": {
          "type": [
            "number",
            "null"
          ]
        },
        "decode_tps": {
          "type": [
            "number",
            "null"
          ]
        },
        "decode_tps_now": {
          "type": [
            "number",
            "null"
          ]
        },
        "cache_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "response",
            "session",
            "prefix",
            "resident",
            "disk",
            "end",
            "none",
            null
          ]
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ended_ms_ago": {
          "type": [
            "number",
            "null"
          ]
        },
        "activity": {
          "$ref": "#/$defs/activity"
        },
        "timeline": {
          "$ref": "#/$defs/timeline"
        },
        "decode_live_now_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "tokens over the last now_window_s of ticks, never before the anchor; null before it and when done. 1.1, VIS-40"
        },
        "decode_live_avg_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "(tokens - n_anchor) / (now - t_anchor); at the end (tokens, t_last). null before the anchor. 1.1, VIS-40"
        },
        "decode_warmup": {
          "type": [
            "object",
            "null"
          ],
          "description": "null before the first token and for a replay. 1.1, VIS-40",
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "decoded tokens so far (the prefill's first token not counted)"
            },
            "reached": {
              "type": "boolean",
              "description": "the anchor exists"
            }
          },
          "required": [
            "tokens",
            "reached"
          ],
          "additionalProperties": false
        },
        "mostly_cached": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "some tokens cached and the new ones under mostly_cached_pct of the prompt or under mostly_cached_tokens; null before the prefill says what it restored. 1.1, VIS-40"
        },
        "lane": {
          "description": "0.3.27-test: served in the side lane (server/preempt.py) -- at a safe point of another request's decode or prefill, or under the lock when none ran (self); pending while it waits for one (live); null for every other request",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "decode",
            "prefill",
            "self",
            "pending",
            null
          ]
        },
        "line": {
          "type": [
            "object",
            "null"
          ],
          "description": "the newest state line the client was shown (narrator v3, the voice: what Qwen is doing right now); null without the lines. Optional",
          "properties": {
            "kind": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "at_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "text",
            "at_ms"
          ],
          "additionalProperties": false
        },
        "backend": {
          "description": "1.3, the proxy: the backend id a relayed request went to; null for the engine's own",
          "type": [
            "string",
            "null"
          ]
        },
        "hidden_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "VIS-58: the prompt tokens TandemLLM added (its notes); prompt_tokens is the client's count and cached_tokens never exceeds it"
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "SRV-347: the conversation the request belongs to (the body's conversation id, else x-session-id), null when the client sent none"
        },
        "thinking_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "SRV-347: the reasoning cap in force, in tokens; null when uncapped or thinking is off"
        }
      },
      "required": [
        "request_id",
        "phase",
        "finish_reason",
        "status",
        "model",
        "client",
        "endpoint",
        "stream",
        "thinking",
        "temperature",
        "prompt_tokens",
        "cached_tokens",
        "forwarded_tokens",
        "tokens",
        "blocks",
        "tokens_per_block",
        "elapsed_ms",
        "queue_ms",
        "prompt_ms",
        "ttft_ms",
        "decode_ms",
        "prefill_tps",
        "decode_tps",
        "decode_tps_now",
        "cache_source",
        "max_tokens",
        "ended_ms_ago",
        "activity",
        "timeline"
      ],
      "additionalProperties": false
    },
    "stop": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "stop",
            "length",
            "tool_calls",
            "timeout",
            "abandoned",
            "error",
            "refused",
            "rejected",
            "cancelled"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "prefilling",
            "replaying",
            "thinking",
            "closing_reasoning",
            "writing",
            "tool_call",
            "finishing",
            "done"
          ]
        },
        "tokens_sent": {
          "type": "integer",
          "minimum": 0
