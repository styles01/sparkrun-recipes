            "thinking_tokens": {
              "type": "integer"
            },
            "content_tokens": {
              "type": "integer"
            },
            "tool_tokens": {
              "type": "integer"
            },
            "tps_now": {
              "type": [
                "number",
                "null"
              ]
            },
            "tps_avg": {
              "type": [
                "number",
                "null"
              ]
            },
            "rounds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "tokens_per_round": {
              "type": [
                "number",
                "null"
              ]
            },
            "tokens_per_round_now": {
              "type": [
                "number",
                "null"
              ]
            },
            "ms_per_round": {
              "type": [
                "number",
                "null"
              ]
            },
            "ms_per_round_now": {
              "type": [
                "number",
                "null"
              ]
            },
            "accept_mean": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "tokens",
            "thinking_tokens",
            "content_tokens",
            "tool_tokens",
            "tps_now",
            "tps_avg",
            "rounds",
            "tokens_per_round",
            "tokens_per_round_now",
            "ms_per_round",
