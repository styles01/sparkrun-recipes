      },
      "required": [
        "reason",
        "detail",
        "state",
        "tokens_sent",
        "silent_ms",
        "client_gone_ms",
        "sentence"
      ],
      "additionalProperties": false
    },
    "activity": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "prefilling",
            "replaying",
            "thinking",
            "closing_reasoning",
            "writing",
            "tool_call",
            "finishing",
            "done"
          ]
        },
        "label": {
          "type": "string"
        },
        "since_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "constrained": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "response_format",
            "tool_choice",
            null
          ]
        },
        "queue": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "place": {
              "type": [
                "integer",
                "null"
              ]
            },
            "wait_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "timeout_s": {
              "type": [
                "number",
                "null"
              ]
            },
            "place_is_estimate": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "0.8.2: why it waits, in words (the slot it waits for, or what holds slot 0); absent on older servers"
            }
          },
          "required": [
            "place",
            "wait_ms",
            "timeout_s",
            "place_is_estimate"
          ],
          "additionalProperties": false
        },
        "prefill": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "done": {
              "type": [
                "integer",
                "null"
              ]
            },
            "total": {
              "type": "integer"
            },
            "cached": {
              "type": [
                "integer",
                "null"
              ]
            },
            "pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "tps_now": {
              "type": [
                "number",
                "null"
              ]
            },
            "tps_avg": {
              "type": [
                "number",
                "null"
              ]
            },
            "eta_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "progress": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "chunked",
                "single_call",
                null
              ]
            },
            "at_ms": {
              "type": [
                "number",
                "null"
              ],
              "description": "ms from arrival when `done` was reached (the chunk's stamp)"
            },
            "tps_live": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "new tokens over the chunk marks of the last now_window_s after the warm-up chunk(s); null before two marks exist past it, for a single call, and when done"
            },
            "tps_live_avg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "from the warm-up anchor to the newest mark; when done, to the first token"
            },
            "why": {
              "type": [
                "string",
                "null"
              ],
              "description": "SRV-546: why this prefill reads 8,192 or more tokens again, in plain words; null otherwise"
            },
            "warmup": {
              "type": "object",
              "properties": {
                "chunks": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "chunks reported so far"
                },
                "reached": {
                  "type": "boolean"
                }
              },
              "required": [
                "chunks",
                "reached"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "done",
            "total",
            "cached",
            "pct",
            "tps_now",
            "tps_avg",
            "eta_ms",
            "progress",
            "at_ms"
          ],
          "additionalProperties": false
        },
