{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/dashboard-v1/session.schema.json",
  "title": "GET /v1/dashboard/session (200)",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "authenticated": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "login": {
      "type": "boolean"
    },
    "password_set": {
      "type": "boolean",
      "description": "AU1 (2026-10-06): an admin password (QSE_ADMIN_TOKEN) is set on the server; false: every admin route is open and the dashboard asks for nothing. Absent on older servers."
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "contract_version",
    "authenticated",
    "login",
    "expires_at"
  ],
  "additionalProperties": false
}
