{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/dashboard-v1/logs-json.schema.json",
  "title": "GET /v1/dashboard/logs?follow=0",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "ts": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warning",
              "error"
            ]
          },
          "source": {
            "type": "string",
            "description": "the line's bracket tag, an open set: req, server, cache, drafter, think, ledger, body, http, ...; stdout / stderr for an untagged line"
          },
          "msg": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "seq",
          "ts",
          "level",
          "source",
          "msg",
          "request_id"
        ],
        "additionalProperties": false
      }
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "contract_version",
    "lines",
    "last_seq"
  ],
  "additionalProperties": false
}
