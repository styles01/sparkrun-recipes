{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/dashboard-v1/requests.schema.json",
  "title": "GET /v1/dashboard/requests",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.3"
      ]
    },
    "next_before": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "type": "string"
          },
          "ts": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "client": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "open-webui",
                  "openai-sdk",
                  "opencode",
                  "hermes",
                  "curl",
                  "dashboard",
                  "other",
                  "internal"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "kind"
            ],
            "additionalProperties": false
          },
          "endpoint": {
            "type": "string",
            "enum": [
              "chat",
              "completions",
              "responses",
              "embeddings"
            ]
          },
          "stream": {
            "type": "boolean"
          },
          "status": {
            "type": "integer",
            "minimum": 100
          },
          "finish_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "stop",
              "length",
              "tool_calls",
              "timeout",
              "abandoned",
              "error",
              "refused",
              "content_filter",
              null
            ]
          },
          "prompt_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cached_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "completion_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "reasoning_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "queue_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "prompt_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "ttft_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "decode_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "total_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "decode_tps": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "prefill_tps": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "blocks": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "tokens_per_block": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "draft_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "draft_accepted": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "tool_calls": {
            "type": "integer",
            "minimum": 0
          },
          "thinking": {
            "type": "boolean"
          },
          "cache_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "response",
              "session",
              "prefix",
              "resident",
              "disk",
              "end",
              "none",
              null
            ]
          },
          "error_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "conductor": {
            "description": "VIS-44: the conductor on this request, from the ledger's columns and the journal; null when it did not run (raw, an older ledger)",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "mode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "acts": {
                "type": "integer",
                "minimum": 0
              },
              "shadow": {
                "type": "integer",
                "minimum": 0
              },
              "hidden_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "acted": {
                "type": "boolean"
              }
            },
            "required": [
              "mode",
              "acts",
              "shadow",
              "hidden_tokens",
              "acted"
            ],
            "additionalProperties": false
          },
          "lane": {
            "description": "0.3.27-test: served in the side lane (server/preempt.py) -- at a safe point of another request's decode or prefill, or under the lock when none ran (self); pending while it waits for one (live); null for every other request",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "decode",
              "prefill",
              "self",
              null
            ]
          },
          "backend": {
            "description": "1.3, the proxy: the backend that answered; null for the engine's own request",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "label"
            ],
            "additionalProperties": false
          },
          "user": {
            "description": "1.3: the label of the proxy API key the request carried",
            "type": [
              "string",
              "null"
            ]
          },
          "measured_at": {
            "description": "1.3: engine (the engine's own loop) or proxy (at the proxy: TTFT holds the network and the backend's queue)",
            "type": "string",
            "enum": [
              "engine",
              "proxy"
            ]
          },
          "backend_model": {
            "description": "1.3: the model id sent upstream",
            "type": [
              "string",
              "null"
            ]
          },
          "usage_source": {
            "description": "1.3: backend (the backend sent usage) or none (token fields null)",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "backend",
              "none",
              null
            ]
          },
          "cache_write_tokens": {
            "description": "1.3: prompt tokens written to a provider cache at a price of their own",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cost_micros": {
            "description": "1.3: micro-dollars at the model's price when the row was written; null without a price",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "proxy_ms": {
            "description": "1.3: the proxy's own time: arrival to the upstream send plus the first frame's delay",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "retries": {
            "description": "1.3: tries again before the first byte",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "fallback_from": {
            "description": "1.3: the backend tried first, when another one answered",
            "type": [
              "string",
              "null"
            ]
          },
          "upstream_status": {
            "description": "1.3: the backend's HTTP status",
            "type": [
              "integer",
              "null"
            ]
          },
          "l2": {
            "description": "1.3, P6: null unless the backend's engine ran TandemLLM's plugin and its numbers reached the row. Then `queue_ms`, `prompt_ms` (prefill), `decode_ms`, `decode_tps`, `prefill_tps` and `cached_tokens` of the row are the engine's own (SGLang adds `blocks`, verify passes, and the draft counts); `join` says how the plugin's item was matched: `exact` by the request id the proxy sent upstream, `approximate` by time and token counts.",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "join": {
                "type": "string",
                "enum": [
                  "exact",
                  "approximate"
                ]
              },
              "preemptions": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "engine_finish": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "corrupted": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "join"
            ],
            "additionalProperties": false
          },
          "parent_request": {
            "type": [
              "string",
              "null"
            ],
            "description": "VIS-60: on an internal row (client kind internal), the request it served"
          },
          "slot": {
            "type": [
              "integer",
              "null"
            ],
            "description": "SRV-197: the engine's sequence slot with parallel requests (0 the main slot, 1 and up a side slot); null without them"
          },
          "sampling": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "client",
              "regenerate",
              "loop_escape",
              "card",
              null
            ],
            "description": "SRV-241: how the request sampled: null greedy (the default), client the client's own sampling, regenerate a regenerate TandemLLM sampled (server/regenerate.py); SRV-475: loop_escape the model card's sampling after a repeated call, card the profile's agentic_default (server/conductor/loopescape.py)"
          },
          "system_fingerprint": {
            "type": [
              "string",
              "null"
            ],
            "description": "VIS-207 (ledger schema 10): the backend configuration a relayed answer named (its system_fingerprint); null for the engine's own rows and a backend that sends none"
          }
        },
        "required": [
          "id",
          "request_id",
          "ts",
          "model",
          "client",
          "endpoint",
          "stream",
          "status",
          "finish_reason",
          "prompt_tokens",
          "cached_tokens",
          "completion_tokens",
          "reasoning_tokens",
          "queue_ms",
          "prompt_ms",
          "ttft_ms",
          "decode_ms",
          "total_ms",
          "decode_tps",
          "prefill_tps",
          "blocks",
          "tokens_per_block",
          "draft_tokens",
          "draft_accepted",
          "tool_calls",
          "thinking",
          "cache_source",
          "error_type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "next_before",
    "requests"
  ],
  "additionalProperties": false
}
