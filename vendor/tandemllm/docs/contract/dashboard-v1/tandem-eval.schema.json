                "properties": {
                  "by_level": {
                    "type": "object"
                  },
                  "by_size": {
                    "type": "object"
                  },
                  "size_mode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "size_applied": {
                    "type": "integer"
                  },
                  "size_effort": {
                    "type": "object"
                  },
                  "outcomes": {
                    "type": "object",
                    "description": "J1: tool-result turns per Tier 0 outcome label"
                  }
                },
                "required": [
                  "by_level",
                  "by_size",
                  "size_mode",
                  "size_applied",
                  "size_effort"
