            "type": "integer"
          },
          "continuations": {
            "type": "integer"
          },
          "interventions": {
            "type": "integer"
          },
          "gave_ups": {
            "type": "integer"
          },
          "efforts": {
            "type": [
              "object",
              "null"
            ],
            "description": "SRV-157: turns per effort level over the runs"
