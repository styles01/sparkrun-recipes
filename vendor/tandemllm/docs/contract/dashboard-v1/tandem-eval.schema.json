              "messages": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "bytes",
              "messages",
              "error"
            ],
            "additionalProperties": false
          },
          "clock": {
            "type": "object",
            "properties": {
              "suite": {
                "type": "string"
              },
              "run": {
                "type": "string"
              }
            },
            "required": [
              "suite",
              "run"
            ],
            "additionalProperties": false,
            "description": "the wall-clock deadline the suite's prompt names, and the run's own that replaced it (its start plus the suite's timeout_min, local HH:MM)"
          },
          "clock_hit": {
            "type": [
              "object",
              "null"
