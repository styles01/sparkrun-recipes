                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "op": {
                      "type": "string"
                    },
                    "limit": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "value",
                    "op",
                    "limit"
