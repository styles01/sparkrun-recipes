            "type": [
              "object",
              "null"
            ],
            "properties": {
              "verdict": {
                "type": "string"
              },
              "readings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "gate": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "op": {
                      "type": "string"
                    },
                    "limit": {
                      "type": "number"
                    }
