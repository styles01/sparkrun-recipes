        },
        "suffix_store": {
          "type": "string"
        }
      },
      "required": [
        "unique_tags",
        "store_clears",
        "suffix_store"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suite": {
            "type": "string"
          },
          "arm": {
            "enum": [
              "raw",
              "tandem"
            ]
          },
          "rep": {
            "type": "integer"
          },
          "tag": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
