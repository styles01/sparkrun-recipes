              }
            },
            "required": [
              "needed",
              "sent",
              "driver"
            ],
            "additionalProperties": false
          },
          "engine": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "requests": {
                "type": "integer"
              },
              "finish": {
                "type": "object"
              },
              "decode_tps_median": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "prefill_tps_median": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "completion_tokens": {
                "type": "integer"
