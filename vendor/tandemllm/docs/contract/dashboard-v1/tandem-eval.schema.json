            "properties": {
              "acts": {
                "type": "integer"
              },
              "by_task": {
                "type": "object"
              },
              "gave_ups": {
                "type": "integer"
              },
              "shadow": {
                "type": "integer"
              },
              "efforts": {
                "type": [
                  "object",
                  "null"
