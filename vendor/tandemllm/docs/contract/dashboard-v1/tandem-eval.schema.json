      "const": "suite"
    },
    "contract_version": {
      "enum": [
        "1.0"
      ]
    },
    "harness": {
      "type": "string"
    },
    "night": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "build": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "changed_during_night": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "code_sha"
