{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TandemLLM eval report (tools/tandem_eval.py, OPS-43)",
  "description": "One night of suites on both arms: report.json under ~/pub-results/tandem-eval/<night>/, and the report the Compare screen reads from the box's conductor evals/ (kind suite).",
