{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/dashboard-v1/usage.schema.json",
  "title": "GET /v1/dashboard/usage",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.3"
      ]
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "bucket": {
      "type": "string",
      "enum": [
        "day",
        "hour"
      ]
    },
    "tz": {
      "type": "string"
    },
    "filters": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "client": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend": {
          "description": "1.3: a backend id, or engine for the engine's own rows",
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "description": "1.3",
          "type": [
            "string",
            "null"
          ]
        },
        "internal": {
          "type": "boolean",
          "description": "VIS-60: TandemLLM's own calls are counted (the query's internal=1)"
        }
      },
      "required": [
        "model",
        "client"
      ],
      "additionalProperties": false
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "prompt_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cached_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "completion_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "reasoning_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "tool_call_requests": {
            "type": "integer",
            "minimum": 0
          },
          "decode_tps_p50": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "decode_tps_p90": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "ttft_ms_p50": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "ttft_ms_p90": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "prefill_tps_p50": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "tokens_per_block_mean": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "draft_acceptance": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cost_micros": {
            "description": "1.3: micro-dollars at the models' prices; null when no row in range had a price",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "start",
          "requests",
          "errors",
          "prompt_tokens",
          "cached_tokens",
          "completion_tokens",
          "reasoning_tokens",
          "total_tokens",
          "tool_call_requests",
          "decode_tps_p50",
          "decode_tps_p90",
          "ttft_ms_p50",
          "ttft_ms_p90",
          "prefill_tps_p50",
          "tokens_per_block_mean",
          "draft_acceptance"
        ],
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call_requests": {
          "type": "integer",
          "minimum": 0
        },
        "thinking_requests": {
          "type": "integer",
          "minimum": 0
        },
        "decode_tps_p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "decode_tps_p90": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ttft_ms_p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ttft_ms_p90": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "prefill_tps_p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tokens_per_block_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "draft_acceptance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "active_days": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micros": {
          "description": "1.3: micro-dollars at the models' prices; null when no row in range had a price",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "requests",
        "errors",
        "refused",
        "prompt_tokens",
        "cached_tokens",
        "completion_tokens",
        "reasoning_tokens",
        "total_tokens",
        "tool_call_requests",
        "thinking_requests",
        "decode_tps_p50",
        "decode_tps_p90",
        "ttft_ms_p50",
        "ttft_ms_p90",
        "prefill_tps_p50",
        "tokens_per_block_mean",
        "draft_acceptance",
        "active_days"
      ],
      "additionalProperties": false
    },
    "top_days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "top_client": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "date",
          "total_tokens",
          "requests",
          "top_client"
        ],
        "additionalProperties": false
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "open-webui",
                  "openai-sdk",
                  "opencode",
                  "hermes",
                  "curl",
                  "dashboard",
                  "other",
                  "internal"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "backends": {
          "description": "1.3: the backends seen in the ledger or configured; `engine` is the engine's own rows",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "users": {
          "description": "1.3: the proxy users seen in the ledger",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "models",
        "clients"
      ],
      "additionalProperties": false
