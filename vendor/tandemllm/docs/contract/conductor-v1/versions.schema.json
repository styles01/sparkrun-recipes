{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor versions",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "kind": {
      "type": "string"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "restored_from": {
            "type": [
              "integer",
              "null"
            ]
          },
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "version",
          "note",
          "author",
          "created_at",
          "restored_from",
          "current"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "kind",
    "name",
    "versions"
  ],
  "additionalProperties": false
}
