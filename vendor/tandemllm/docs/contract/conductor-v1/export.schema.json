{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor export",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "session": {
      "type": "string"
    },
    "turns": {
      "type": "integer"
    },
    "interventions": {
      "type": "integer"
    },
    "injections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "router",
              "monitor"
            ]
          },
          "id": {
            "type": "string"
          },
          "ts_ms": {
            "type": "integer"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "tokens": {
            "type": "integer"
          },
          "pos": {
            "type": [
              "integer",
              "null"
            ]
          },
          "hidden": {
            "type": "boolean"
          },
          "parts": {
            "type": [
              "array",
              "null"
            ]
          },
          "tokens_at_cut": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cap": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "object",
              "null"
            ]
          },
          "next_checker": {
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "source",
          "id",
          "ts_ms",
          "request_id",
          "task",
          "action",
          "reason",
          "text",
          "tokens",
          "pos",
          "hidden",
          "outcome",
          "next_checker"
        ],
        "additionalProperties": false
      }
    },
    "hidden_texts": {
      "type": "integer",
      "description": "the interventions whose text the model saw and the client did not"
    },
    "summary": {
      "type": "string",
      "description": "\"N interventions in M turns\""
    },
    "transcript": {
      "type": [
        "object",
        "null"
      ],
      "description": "VIS-48: where the session's transcript is; its text is the admin-only memory export",
      "properties": {
        "blocks": {
          "type": [
            "integer",
            "null"
          ]
        },
        "export": {
          "type": "string"
        }
      },
      "required": [
        "blocks",
        "export"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "session",
    "turns",
    "interventions",
    "hidden_texts",
    "summary",
    "injections"
  ],
  "additionalProperties": false
}
