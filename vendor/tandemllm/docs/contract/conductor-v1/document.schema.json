{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor document",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "kind": {
      "enum": [
        "settings",
        "router",
        "roles",
        "packages",
        "monitor",
        "residency",
        "deciders",
        "profiles"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer"
    },
    "doc": {
      "type": "object"
    },
    "meta": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "restored_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "loaded_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "object",
            "null"
          ]
        },
        "defaults": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SRV-133: the fields a version stored before them was loaded with, one role.field=value each"
        }
      },
      "required": [
        "version",
        "note",
        "author",
        "created_at",
        "restored_from",
        "loaded_at",
        "error"
      ],
      "additionalProperties": false
    },
    "locked": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "kind",
    "name",
    "version",
    "doc",
    "meta"
  ],
  "additionalProperties": false
}
