{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor packages document",
  "type": "object",
  "properties": {
    "skill_dirs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      },
      "maxItems": 8
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "skill",
              "package"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^(inline|skill:[a-z0-9][a-z0-9_.-]*|file:.+)$"
          },
          "description": {
            "type": "string",
            "minLength": 8,
            "maxLength": 600
          },
          "body": {
            "type": "string",
            "maxLength": 200000
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 16,
            "maximum": 32768
          },
          "enabled": {
            "type": "boolean"
          },
          "general": {
            "type": "boolean"
          },
          "library": {
            "type": "boolean"
          },
          "requires_tools": {
            "type": "array",
            "items": {
              "enum": [
                "shell",
                "write",
                "render",
                "render_video"
              ]
            },
            "maxItems": 4
          },
          "fallback": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "maxLength": 80
          },
          "deliverable": {
            "enum": [
              "send",
              "schedule",
              "post"
            ]
          }
        },
        "required": [
          "title",
          "kind",
          "source",
          "description",
          "body",
          "max_tokens",
          "enabled"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "skill_dirs",
    "packages"
  ],
  "additionalProperties": false
}
