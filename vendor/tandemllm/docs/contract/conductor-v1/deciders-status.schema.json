{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor deciders status",
  "description": "GET /v1/conductor/deciders/status (SRV-131): the decision models this engine serves (engine/decision, stage A), each with its state and numbers, the residency planner's answer for a load now, the last refused engine load, and the model behind each question id with the models `auto` picked for its last calls. `enabled` false (and `why`) when QWEN38_DECIDER_MODELS is empty; the `deciders` document itself is GET/PUT /v1/conductor/deciders like the others",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "why": {
      "type": [
        "string",
        "null"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "window": {
      "enum": [
        "idle"
      ]
    },
    "families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "planner": {
      "$ref": "#/$defs/decision"
    },
    "last_refusal": {
      "$ref": "#/$defs/decision"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "picks": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        },
        "required": [
          "id",
          "model",
          "picks"
        ],
        "additionalProperties": false
      }
    },
    "unserved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "api": {
      "type": "object",
      "description": "L1: Laya for the model's scripts, POST /v1/laya/ask: the deciders document's api section and the route's counts since the start; X1: the driver sessions' limits (drive_*) and how many are live (stats.drive_sessions)",
      "required": [
        "mode",
        "rate_per_min",
        "max_texts",
        "max_chars",
        "deadline_ms",
        "threshold",
        "stats"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "off",
            "on"
          ]
        },
        "rate_per_min": {
          "type": "integer"
        },
        "max_texts": {
          "type": "integer"
        },
        "max_chars": {
          "type": "integer"
        },
        "deadline_ms": {
          "type": "integer"
        },
        "threshold": {
          "type": "number"
        },
        "stats": {
          "type": "object",
          "required": [
            "calls",
            "texts",
            "errors",
            "rate_limited",
            "last_ms",
            "last_at"
          ],
          "additionalProperties": false,
          "properties": {
            "calls": {
              "type": "integer"
            },
            "texts": {
              "type": "integer"
            },
            "errors": {
              "type": "integer"
            },
            "rate_limited": {
              "type": "integer"
            },
            "last_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "last_at": {
              "type": [
                "number",
                "null"
              ]
            },
            "drive_sessions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "drive_rate_per_s": {
          "type": "integer"
        },
        "drive_sessions": {
          "type": "integer"
        },
        "drive_idle_s": {
          "type": "integer"
        },
        "drive_max_texts": {
          "type": "integer"
        }
      }
    }
  },
  "required": [
    "enabled",
    "why",
    "ready",
    "device",
    "window",
    "families",
    "models",
    "planner",
    "last_refusal",
    "questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "model": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "contract": {
          "enum": [
            "systemone",
            "probe"
          ]
        },
        "role": {
          "type": "object",
          "description": "the role contract the model signs (SRV-133): the roles document's contract fields",
          "properties": {
            "kind": {
              "type": "string"
            },
            "memory_claim_gib": {
              "type": [
                "number",
                "null"
              ]
            },
            "window": {
              "type": "string"
            },
            "preemptible": {
              "type": "boolean"
            },
            "latency_budget_ms": {
              "type": "integer"
            },
            "fallback": {
              "type": "string"
            },
            "tokenizer_sha256": {
              "type": "string"
            },
            "writes": {
              "type": "string"
            },
            "sharing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "memory_claim_gib",
            "window",
            "preemptible",
            "latency_budget_ms",
            "fallback",
            "tokenizer_sha256",
            "writes",
            "sharing"
          ],
          "additionalProperties": false
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owned_by": {
          "type": "string"
        },
        "state": {
          "enum": [
            "not_loaded",
            "loading",
            "warming",
            "loaded",
            "unloading",
            "failed"
          ]
        },
        "load": {
          "enum": [
            "on_start",
            "on_demand",
            "off"
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "context_tokens": {
              "type": "integer"
            },
            "question_tokens": {
              "type": "integer"
            },
            "max_options": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_bytes": {
          "type": "integer"
        },
        "weight_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "warm": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "loaded_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "questions": {
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "refusal": {
          "$ref": "#/$defs/decision"
        },
        "stats": {
          "$ref": "#/$defs/stats"
        },
        "memory_hold": {
          "description": "0.6.1 (server/rolemem.py): unloaded while memory was short; nothing loads it on demand until the role governor lifts the hold",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "family",
        "contract",
        "role",
        "aliases",
        "state",
        "load",
        "limits",
        "precision",
        "device",
        "device_bytes",
        "weight_hash",
        "warm",
        "loaded_at",
        "questions",
        "error",
        "refusal",
        "stats"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": [
        "object",
        "null"
      ],
      "description": "server/conductor/residency.py check(): the planner's decision with the numbers it was made on",
      "properties": {
        "role": {
          "type": "string"
        },
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "refused_hold",
            "refused_load_in_progress",
            "refused_memory",
            "refused_unknown_role"
          ]
        },
        "mem_available_gib": {
          "type": [
            "number",
            "null"
          ]
        },
        "claim_gib": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "floor_gib": {
          "type": "number"
        },
        "margin_gib": {
          "type": "number"
        },
        "need_gib": {
          "type": "number"
        },
        "after_gib": {
          "type": [
            "number",
            "null"
          ]
        },
        "state": {
          "enum": [
            "not_loaded",
            "loading",
            "warming",
            "loaded",
            "unloading",
            "failed"
          ]
        },
        "at": {
          "type": "number"
        },
        "kind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "engine_peak_gib": {
          "type": [
            "number",
            "null"
          ],
          "description": "OPS-47: the engine's declared peak (MEM_PEAK_GIB), GiB"
        },
        "engine_now_gib": {
          "type": [
            "number",
            "null"
          ],
          "description": "OPS-47: what the engine's allocator holds now (reserved, the decision models left out), GiB"
        },
        "engine_growth_gib": {
          "type": "number",
          "description": "OPS-47: what the engine may still take, peak minus now (the whole peak with no reading), subtracted before the claim"
        }
      },
      "required": [
        "allowed",
        "reason"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "forwards": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "deadline_missed": {
          "type": "integer"
        },
        "queue_rows": {
          "type": "integer"
        },
        "last_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "forward_ms_p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "forward_ms_p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "rows_per_forward_p50": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "forwards",
        "rows",
        "errors",
        "deadline_missed",
        "queue_rows",
        "last_path",
        "forward_ms_p50",
        "forward_ms_p95"
      ],
      "additionalProperties": false
    }
  }
}
