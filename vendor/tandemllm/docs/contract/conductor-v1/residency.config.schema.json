{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor residency document",
  "type": "object",
  "properties": {
    "floor_gib": {
      "type": "number",
      "minimum": 0,
      "maximum": 128
    },
    "margin_gib": {
      "type": "number",
      "minimum": 0,
      "maximum": 64
    },
    "settle_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "order": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,39}$"
      },
      "maxItems": 16
    },
    "claims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "gib": {
            "type": "number",
            "minimum": 0,
            "maximum": 128
          },
          "basis": {
            "enum": [
              "measured",
              "peak",
              "declared"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "gib",
          "basis",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "engine": {
      "type": "object",
      "properties": {
        "MEM_CEILING_GIB": {
          "type": "number",
          "minimum": 0,
          "maximum": 128
        },
        "MEM_PEAK_GIB": {
          "type": "number",
          "minimum": 0,
          "maximum": 128
        },
        "RESERVE_SLACK_GIB": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "RESIDENT_GB": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "RESIDENT_STASH_GB": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "RESIDENT_GUEST_MAX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "RESIDENT_PIN_GB": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "RESIDENT_PARK_GB": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "CACHE_GB": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "STORE_ENTRY_GB": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "VISION_EMBED_MB": {
          "type": "number",
          "minimum": 0,
          "maximum": 8192
        },
        "SUFFIX_STORE_MB": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096
        },
        "PREFIX_CHUNK": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "NARROW_ARM": {
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "floor_gib",
    "margin_gib",
    "settle_s",
    "order",
    "claims"
  ],
  "additionalProperties": false
}
