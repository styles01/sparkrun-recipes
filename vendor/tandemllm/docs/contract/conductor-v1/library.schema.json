{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /v1/library: the package library's enabled skills and its two routes (R1)",
  "type": "object",
  "required": ["object", "count", "skills", "search", "read", "auth"],
  "additionalProperties": false,
  "properties": {
    "object": {"const": "library"},
    "count": {"type": "integer", "minimum": 1},
    "skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skill"}},
    "search": {"type": "string"},
    "read": {"type": "string"},
    "auth": {"type": "string"}
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["name", "description", "classes"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "description": {"type": "string"},
        "classes": {"type": ["array", "null"], "items": {"type": "string"}}
      }
    }
  }
}
