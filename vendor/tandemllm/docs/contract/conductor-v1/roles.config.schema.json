{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor roles document",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "endpoint": {
        "type": "string",
        "maxLength": 400
      },
      "model": {
        "type": "string",
        "maxLength": 200
      },
      "contract": {
        "enum": [
          "jev",
          "openai-chat",
          "rerank",
          "generate"
        ]
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 120000
      },
      "mode": {
        "enum": [
          "off",
          "shadow",
          "on"
        ]
      },
      "kind": {
        "enum": [
          "reasoner",
          "decider",
          "probe",
          "clerk",
          "librarian",
          "tool",
          "generative"
        ]
      },
      "memory_claim_gib": {
        "type": "number",
        "minimum": 0,
        "maximum": 128
      },
      "window": {
        "enum": [
          "idle",
          "in_decode",
          "any",
          "between_rounds"
        ]
      },
      "preemptible": {
        "type": "boolean"
      },
      "latency_budget_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "fallback": {
        "enum": [
          "PASS",
          "stale",
          "skip",
          "next-role"
        ]
      },
      "tokenizer_sha256": {
        "type": "string",
        "pattern": "^(none|[0-9a-f]{64})$"
      },
      "writes": {
        "enum": [
          "client_visible",
          "hidden_notes",
          "memory_files",
          "nothing",
          "state_lines"
        ]
      },
      "sharing": {
        "type": "array",
        "items": {
          "enum": [
            "text",
            "tokens",
            "states"
          ]
        },
        "maxItems": 3
      }
    },
    "required": [
      "endpoint",
      "model",
      "contract",
      "timeout_ms",
      "mode",
      "kind",
      "memory_claim_gib",
      "window",
      "preemptible",
      "latency_budget_ms",
      "fallback",
      "tokenizer_sha256",
      "writes",
      "sharing"
    ],
    "additionalProperties": false
  }
}
