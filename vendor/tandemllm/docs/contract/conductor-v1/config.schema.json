{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor config",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "server": {
      "type": "object",
      "properties": {
        "composite": {
          "type": "string"
        },
        "raw_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "global_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "self_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "monitor_mode": {
          "type": "string",
          "enum": [
            "raw",
            "shadow",
            "on"
          ],
          "description": "the session monitor's --conductor mode; raw: it does not run"
        }
      },
      "required": [
        "composite",
        "raw_model",
        "reasoning_effort",
        "global_mode",
        "self_url"
      ],
      "additionalProperties": false
    },
    "store": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "readonly": {
          "type": "boolean"
        },
        "writes": {
          "type": "integer"
        },
        "documents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "version": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "loaded_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "error": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "version",
              "loaded_at",
              "error"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "root",
        "readonly",
        "writes",
        "documents"
      ],
      "additionalProperties": false
    },
    "journal": {
      "type": "object",
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "ring": {
          "type": "integer"
        },
        "queue": {
          "type": "integer"
        },
        "dropped": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "retention_days": {
          "type": "integer"
        },
        "events_ring": {
          "type": "integer"
        },
        "monitor_rows": {
          "type": "integer"
        },
        "writer_alive": {
          "type": "boolean"
        },
        "table": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "ring",
        "queue",
        "dropped",
        "errors",
        "retention_days"
      ],
      "additionalProperties": false,
      "description": "the conductor's one journal (router and monitor): the usage ledger's file in production (table conductor_events), null path with the ledger off"
    },
    "time": {
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "server",
    "store",
    "journal",
    "time"
  ],
  "additionalProperties": false
}
