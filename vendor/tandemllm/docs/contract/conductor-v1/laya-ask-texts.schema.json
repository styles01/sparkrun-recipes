{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/laya/ask with texts: one answer a text, in order (L1)",
  "type": "object",
  "required": [
    "answers",
    "model",
    "ms"
  ],
  "additionalProperties": false,
  "properties": {
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "laya-ask.schema.json#/$defs/answer"
      }
    },
    "model": {
      "type": "string"
    },
    "ms": {
      "type": "number",
      "minimum": 0
    }
  }
}
