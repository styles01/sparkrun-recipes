{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor scan",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "chars": {
            "type": "integer"
          },
          "registered": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "description",
          "path",
          "chars",
          "registered"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "skills"
  ],
  "additionalProperties": false
}
