{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor sessions",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "client_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_ms": {
            "type": "integer"
          },
          "turns": {
            "type": "integer"
          },
          "notes": {
            "type": "integer"
          },
          "note_tokens": {
            "type": "integer"
          },
          "classes": {
            "type": "object"
          },
          "class_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_ms": {
            "type": "integer"
          },
          "last_checker": {
            "type": [
              "string",
              "null"
            ]
          },
          "labels": {
            "type": "integer"
          },
          "acts": {
            "type": "integer",
            "minimum": 0
          },
          "gave_ups": {
            "type": "integer",
            "minimum": 0
          },
          "shadow": {
            "type": "integer",
            "minimum": 0
          },
          "interventions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "key",
          "client_kind",
          "profile",
          "started_ms",
          "turns",
          "notes",
          "note_tokens",
          "classes",
          "class_id",
          "last_ms",
          "last_checker",
          "labels",
          "acts",
          "gave_ups",
          "shadow",
          "interventions"
        ],
        "additionalProperties": false
      }
    },
    "live": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "class_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "turns": {
            "type": "integer"
          },
          "notes": {
            "type": "integer"
          },
          "note_tokens": {
            "type": "integer"
          },
          "calls": {
            "type": "object",
            "description": "0.3.23-test: the session's out-of-band calls by kind (library, laya), from its session address"
          }
        },
        "required": [
          "key",
          "class_id",
          "confidence",
          "source",
          "turns",
          "notes",
          "note_tokens"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "sessions",
    "live"
  ],
  "additionalProperties": false
}
