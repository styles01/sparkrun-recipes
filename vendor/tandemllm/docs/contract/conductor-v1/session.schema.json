{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conductor session",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "session": {
      "type": "string"
    },
    "live": {
      "type": [
        "object",
        "null"
      ]
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "decisions.schema.json#/$defs/decision"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "decisions.schema.json#/$defs/event"
      }
    }
  },
  "required": [
    "contract_version",
    "session",
    "live",
    "turns",
    "events"
  ],
  "additionalProperties": false
}
