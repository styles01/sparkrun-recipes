# latexmk settings for the manual: LuaLaTeX, makeindex, output beside the source.
$pdf_mode = 4;                     # lualatex
$lualatex = 'lualatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
$makeindex = 'makeindex -s tandem.ist %O -o %D %S';
$max_repeat = 6;
@default_files = ('tandemllm-manual.tex');
