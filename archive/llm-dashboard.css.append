/* ─── LLM telemetry dashboard ─────────────────────────── */
/* Real-time home for LLM telemetry: header bar, stat cards, charts, table. */

.llm-dashboard {
  --llm-gap: 14px;
}

/* Header bar: health dot + model/backend/context/port fields */
.llm-header-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  background: var(--color-surface-elevated);
}
.llm-header-down {
  background: color-mix(in srgb, var(--color-surface-elevated) 80%, var(--color-danger) 4%);
}
.llm-health {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-right: 14px;
  border-right: 1px solid var(--color-border);
}
.llm-health-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  flex-shrink: 0;
}
.llm-health-up {
  background: var(--color-success);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-success) 24%, transparent);
  animation: llm-pulse 1.8s ease-in-out infinite;
}
.llm-health-idle {
  background: var(--color-success);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-success) 14%, transparent);
}
.llm-health-down {
  background: var(--color-danger);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-danger) 24%, transparent);
}
.llm-health-text {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--color-muted-strong);
}
@keyframes llm-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
.llm-header-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
  flex: 1;
  min-width: 0;
}
.llm-header-field {
  display: flex;
  align-items: baseline;
  gap: 6px;
  min-width: 0;
}
.llm-header-key {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
}
.llm-header-val {
  font-size: 12px;
  color: var(--color-text);
  max-width: 240px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Live stats row */
.llm-stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 10px;
}
.llm-stat-card {
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  background: var(--color-surface-elevated);
  transition: border-color 0.18s ease;
}
.llm-stat-card:hover {
  border-color: var(--color-border-strong);
}
.llm-stat-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
  margin-bottom: 4px;
}
.llm-stat-value {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.1;
  color: var(--color-text);
  transition: color 0.3s ease;
}
.llm-stat-sub {
  font-size: 10px;
  color: var(--color-muted);
  margin-top: 2px;
}
.llm-stat-bar {
  margin-top: 6px;
  height: 3px;
  border-radius: 9999px;
  background: var(--color-border);
  overflow: hidden;
}
.llm-stat-bar-fill {
  height: 100%;
  border-radius: 9999px;
  transition: width 0.4s ease, background 0.3s ease;
}

/* Chart block wrapper */
.llm-chart-block {
  padding: 12px 14px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  background: var(--color-surface-elevated);
}
.llm-chart-title {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted-strong);
  margin-bottom: 8px;
}
.llm-chart-sub {
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  color: var(--color-muted);
  margin-left: 6px;
}

/* Canvas chart wrapper */
.telemetry-chart-wrap {
  width: 100%;
  position: relative;
}
.telemetry-chart-wrap canvas {
  display: block;
  width: 100%;
}

/* Per-slot table */
.llm-slot-table {
  overflow-x: auto;
}
.llm-slot-table table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.llm-slot-table th {
  text-align: left;
  padding: 6px 10px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
  border-bottom: 1px solid var(--color-border);
  font-weight: 500;
}
.llm-slot-table td {
  padding: 6px 10px;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text);
}
.llm-slot-table tr:last-child td {
  border-bottom: none;
}
.llm-slot-table tr:hover td {
  background: var(--color-surface-hover);
}

/* Bottom grid: moving averages + MTP panel */
.llm-bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
@media (max-width: 760px) {
  .llm-bottom-grid {
    grid-template-columns: 1fr;
  }
}

/* Moving averages */
.llm-ma-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}
.llm-ma-card {
  padding: 8px 10px;
  border-radius: 10px;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}
.llm-ma-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
}
.llm-ma-value {
  font-size: 14px;
  font-weight: 600;
  color: var(--color-text);
}
.llm-trend-up {
  color: var(--color-success);
  font-size: 10px;
}
.llm-trend-down {
  color: var(--color-danger);
  font-size: 10px;
}
.llm-trend-neutral {
  color: var(--color-muted);
  font-size: 10px;
}

/* MTP / Spec decode panel */
.llm-mtp-body {
  display: flex;
  align-items: center;
  gap: 18px;
}
@media (max-width: 540px) {
  .llm-mtp-body {
    flex-direction: column;
    align-items: flex-start;
  }
}
.llm-gauge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}
.llm-gauge-text {
  font-size: 16px;
  font-weight: 700;
}
.llm-gauge-caption {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
}
.llm-mtp-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.llm-mtp-counters {
  display: flex;
  gap: 18px;
}
.llm-mtp-counter-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
}
.llm-mtp-counter-val {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text);
}
.llm-mtp-positions {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.llm-mtp-pos-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
  margin-bottom: 2px;
}
.llm-mtp-pos-bars {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.llm-mtp-pos-bar {
  display: grid;
  grid-template-columns: 40px 1fr 44px;
  align-items: center;
  gap: 8px;
}
.llm-mtp-pos-bar-track {
  height: 6px;
  border-radius: 9999px;
  background: var(--color-border);
  overflow: hidden;
}
.llm-mtp-pos-bar-fill {
  height: 100%;
  border-radius: 9999px;
  transition: width 0.4s ease, background 0.3s ease;
}
.llm-mtp-pos-bar-label {
  font-size: 10px;
  color: var(--color-muted);
}
.llm-mtp-pos-bar-val {
  font-size: 10px;
  color: var(--color-text);
  text-align: right;
}