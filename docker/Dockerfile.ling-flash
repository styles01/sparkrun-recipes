# Ling-3.0-flash INT4 serving image — reproducible artifact for the arena recipe.
# Base: stock aarch64 vLLM v0.25.1 (has GB10 kernels). We overlay the verified
# precompiled ling_3_0 fork (bailing_moe_v3 + ling3 parser + KDA kernels) from the
# Spark venv. The INT4 model is bind-mounted at runtime (77GB — too big to bake).
FROM vllm/vllm-openai:v0.25.1

# Overlay the precompiled ling fork vllm package over the base image's vllm
# (base installs to dist-packages, not site-packages)
COPY ling-vllm/ /opt/ling-vllm/
RUN cp -r /opt/ling-vllm/* /usr/local/lib/python3.12/dist-packages/vllm/ && \
    rm -rf /opt/ling-vllm

# CRITICAL GB10 FIX: cap KDA kernel num_stages to 2. Ling's KDA kernels autotune
# num_stages in [2,3,4]; stages 3/4 need 133-139KB shared memory > GB10's 101KB,
# so autotune intermittently fails and the engine wedges at generation time
# (D-state, GPU 0%, whole box hangs). Capping to [2] makes every candidate fit.
# Same class of fix as patch_fla_shmem.py for lightning_attn.
RUN sed -i 's/for num_stages in \[2, 3, 4\]/for num_stages in [2]/g' \
    /usr/local/lib/python3.12/dist-packages/vllm/third_party/flash_linear_attention/ops/kda.py \
    && grep -c 'for num_stages in \[2\]' \
    /usr/local/lib/python3.12/dist-packages/vllm/third_party/flash_linear_attention/ops/kda.py \
    && echo "KDA num_stages capped to 2 (3 configs patched)"

# GB10 decode-attention fix: grouped MLA decode with BLOCK_DMODEL=512 still used
# two stages (102,400 B shared memory) — 1,024 B above GB10's 101,376 B limit.
# This is distinct from the KDA autotune cap above. Force stage 1 for this path.
RUN python3 -c "from pathlib import Path; p=Path('/usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/triton_decode_attention.py'); s=p.read_text(); old='    num_stages = 2\\n    if is_hip_:'; new='    num_stages = 1\\n    if is_hip_:'; assert s.count(old) == 1, s.count(old); p.write_text(s.replace(old, new))" && \
    grep -A12 'extra_kargs = {}' /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/triton_decode_attention.py | grep -q 'num_stages = 1'

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    CUTE_DSL_ARCH=sm_121a \
    TRITON_CACHE_DIR=/root/.cache/triton-ling-gb10

# Model is bind-mounted by sparkrun. CRITICAL for native sparkrun launch:
# 1) ENTRYPOINT [] (must override base image's baked ["vllm","serve"]) so the
#    entrypoint-probe reports "absent" and passes.
# 2) CMD ["sleep","infinity"] so the container starts INSTANTLY and sparkrun's
#    liveness check passes BEFORE vLLM finishes loading the 72GB model (~5min).
#    sparkrun then `docker exec`s the serve command into the running container.
#    Mirrors v26-sparkrun (July 28 lesson: "built sleep-infinity entrypoint image
#    for sparkrun compat"). Without it, the liveness check kills the container
#    during cold load and the native launch aborts.
ENTRYPOINT []
CMD ["sleep", "infinity"]
